<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================
         TOKEN SÖZLÜĞÜ — Voice-First Multimodal
         LIGHT · "WHITE FROST"  — saf beyaz, ferah, temiz
             beyaz zemin, pastel şeftali-lavanta-gökyüzü aurora,
             mürekkep indigo aksan
         DARK  · "OBSIDIAN AURORA" — derin, kromatik, sinematik
             obsidyen zemin, görünür indigo-turkuaz-mor ambient,
             lüminesan indigo aksan
         İlke: cam, arkasındaki renkli ışıkla görünür.
         NOT: gradient fade'lerde ASLA #00000000 (Transparent) kullanma —
         siyah smear üretir. Rengin %0 alfalı (Clear) hâlini kullan.
         ============================================================ -->

    <!-- ============ LIGHT THEME ============ -->

    <!-- ACCENT: mürekkep indigo (ana karakter) -->
    <Color x:Key="Accent">#4F46E5</Color>
    <Color x:Key="AccentDark">#4338CA</Color>
    <Color x:Key="AccentSoft">#ECEAFE</Color>
    <Color x:Key="AccentContrast">#FFFFFF</Color>

    <!-- SECONDARY: premium turkuaz (voice, listening, success) -->
    <Color x:Key="Secondary">#0D9488</Color>
    <Color x:Key="SecondaryDark">#0F766E</Color>
    <Color x:Key="SecondarySoft">#E0F4F1</Color>

    <!-- SURFACE — açık gri zemin (beyaz değil, kullanıcı tercihi) -->
    <Color x:Key="Background">#F4F5F8</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceElevated">#FFFFFF</Color>
    <Color x:Key="SurfaceMuted">#E9EBF0</Color>

    <!-- TEXT — soğuk mürekkep -->
    <Color x:Key="TextPrimary">#111827</Color>
    <Color x:Key="TextSecondary">#4B5563</Color>
    <Color x:Key="TextTertiary">#9CA3AF</Color>

    <!-- BORDER — soğuk hairlines -->
    <Color x:Key="BorderDefault">#E5E7EB</Color>
    <Color x:Key="BorderStrong">#D1D5DB</Color>

    <!-- CAM (Liquid Glass) — beyaz, görünür -->
    <Color x:Key="GlassBackground">#E6FFFFFF</Color>
    <Color x:Key="GlassBorder">#C9FFFFFF</Color>
    <Color x:Key="GlassHighlight">#FFFFFF</Color>

    <!-- GÖLGE — soğuk koyu mavi-kurşun tonu -->
    <Color x:Key="ShadowSm">#14111827</Color>
    <Color x:Key="ShadowMd">#1F111827</Color>
    <Color x:Key="ShadowLg">#2B111827</Color>

    <!-- STATE -->
    <Color x:Key="Success">#059669</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="Info">#2563EB</Color>

    <!-- Voice recording -->
    <Color x:Key="Recording">#DC2626</Color>
    <Color x:Key="RecordingSoft">#FDEBE9</Color>
    <Color x:Key="RecordingBackground">#FDEBE9</Color>
    <Color x:Key="VoiceReady">#059669</Color>
    <Color x:Key="VoiceReadySoft">#E2F4EC</Color>
    <Color x:Key="VoiceReadyBackground">#E2F4EC</Color>

    <!-- PRIORITY -->
    <Color x:Key="PriorityHigh">#DC2626</Color>
    <Color x:Key="PriorityMedium">#D97706</Color>
    <Color x:Key="PriorityLow">#059669</Color>

    <!-- AURORA — Light: açık gri üstüne görünür pastel aurora
         (dark'taki kompozisyonun light'a uyarlanmış hâli — silme, uyarla) -->
    <Color x:Key="AuroraTop">#F8F9FB</Color>
    <Color x:Key="AuroraMid">#F1F2F7</Color>
    <Color x:Key="AuroraBottom">#E4E8F2</Color>
    <Color x:Key="AuroraGlowPeach">#FFC9A3</Color>
    <Color x:Key="AuroraGlowLavender">#C9B8FF</Color>
    <Color x:Key="AuroraGlowSky">#A8D8FF</Color>
    <Color x:Key="AuroraGlowMint">#A8E8D8</Color>

    <!-- AURORA fade — renklerin %0 alfalı hâli (siyah smear önler) -->
    <Color x:Key="AuroraGlowPeachClear">#00FFC9A3</Color>
    <Color x:Key="AuroraGlowLavenderClear">#00C9B8FF</Color>
    <Color x:Key="AuroraGlowSkyClear">#00A8D8FF</Color>
    <Color x:Key="AuroraGlowMintClear">#00A8E8D8</Color>

    <!-- Aksan glow (MIC halkası vb.) -->
    <Color x:Key="AccentGlow">#3D4F46E5</Color>
    <Color x:Key="AccentGlowSoft">#264F46E5</Color>

    <!-- ============ DARK THEME · "OBSIDIAN AURORA" ============ -->

    <!-- ACCENT — Dark: lüminesan indigo -->
    <Color x:Key="DarkAccent">#8B93FF</Color>
    <Color x:Key="DarkAccentSoft">#232047</Color>
    <Color x:Key="DarkAccentContrast">#FFFFFF</Color>

    <!-- SECONDARY — Dark: parlak turkuaz -->
    <Color x:Key="DarkSecondary">#2DD4BF</Color>
    <Color x:Key="DarkSecondarySoft">#0A2E2B</Color>

    <!-- SURFACE — Dark: derin obsidyen (asla saf siyah değil) -->
    <Color x:Key="DarkBackground">#0B0A12</Color>
    <Color x:Key="DarkSurface">#14121E</Color>
    <Color x:Key="DarkSurfaceElevated">#1C1929</Color>
    <Color x:Key="DarkSurfaceMuted">#242031</Color>

    <!-- TEXT — Dark: sıcak beyaz, menekşe tonu -->
    <Color x:Key="DarkTextPrimary">#F0EDF6</Color>
    <Color x:Key="DarkTextSecondary">#A39BB3</Color>
    <Color x:Key="DarkTextTertiary">#6E6580</Color>

    <!-- BORDER — Dark: görünür glass hairline -->
    <Color x:Key="DarkBorderDefault">#262233</Color>
    <Color x:Key="DarkBorderStrong">#322C45</Color>

    <!-- CAM — Dark: görünür, hafif indigo tonlu beyaz -->
    <Color x:Key="DarkGlassBackground">#30FFFFFF</Color>
    <Color x:Key="DarkGlassBorder">#4AFFFFFF</Color>
    <Color x:Key="DarkGlassHighlight">#70FFFFFF</Color>

    <!-- GÖLGE — Dark -->
    <Color x:Key="DarkShadowSm">#40000000</Color>
    <Color x:Key="DarkShadowMd">#52000000</Color>
    <Color x:Key="DarkShadowLg">#66000000</Color>

    <!-- VOICE — Dark -->
    <Color x:Key="DarkRecordingSoft">#2D1B1E</Color>
    <Color x:Key="DarkVoiceReadySoft">#0C2920</Color>

    <!-- AURORA — Dark: güçlü, kromatik ambient (camın arkasındaki ışık) -->
    <Color x:Key="DarkAuroraTop">#0B0A12</Color>
    <Color x:Key="DarkAuroraMid">#100F1A</Color>
    <Color x:Key="DarkAuroraBottom">#161427</Color>
    <Color x:Key="DarkAuroraGlowIndigo">#332E7A</Color>
    <Color x:Key="DarkAuroraGlowTeal">#0F4A4E</Color>
    <Color x:Key="DarkAuroraGlowViolet">#4A2A7A</Color>
    <Color x:Key="DarkAuroraGlowAmethyst">#57286E</Color>

    <!-- AURORA fade — Dark renklerin %0 alfalı hâli -->
    <Color x:Key="DarkAuroraGlowIndigoClear">#00332E7A</Color>
    <Color x:Key="DarkAuroraGlowTealClear">#000F4A4E</Color>
    <Color x:Key="DarkAuroraGlowVioletClear">#004A2A7A</Color>
    <Color x:Key="DarkAuroraGlowAmethystClear">#0057286E</Color>

    <!-- Aksan glow — Dark (MIC halkası vb.) -->
    <Color x:Key="DarkAccentGlow">#3D8B93FF</Color>
    <Color x:Key="DarkAccentGlowSoft">#268B93FF</Color>

    <!-- STATE — Dark -->
    <Color x:Key="DarkSuccess">#34D399</Color>
    <Color x:Key="DarkWarning">#FBBF24</Color>
    <Color x:Key="DarkDanger">#F87171</Color>

</ResourceDictionary>
