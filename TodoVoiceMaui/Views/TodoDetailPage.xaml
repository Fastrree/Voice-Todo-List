<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TodoVoiceMaui.ViewModels"
             xmlns:models="clr-namespace:TodoVoiceMaui.Models"
             xmlns:converters="clr-namespace:TodoVoiceMaui.Converters"
             x:Class="TodoVoiceMaui.Views.TodoDetailPage"
             x:DataType="viewmodels:TodoDetailPageViewModel"
             Title="Görev Detayı">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Todo Info -->
            <Frame Style="{StaticResource CardFrame}">
                <StackLayout Spacing="15">
                    
                    <Label Text="{Binding Title}"
                           Style="{StaticResource HeadlineMedium}" />
                    
                    <Label Text="{Binding Description}"
                           Style="{StaticResource BodyLarge}"
                           IsVisible="{Binding Description, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                    
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="Öncelik:"
                               Style="{StaticResource LabelMedium}" />
                        <Label Text="{Binding Priority}"
                               Style="{StaticResource BodyMedium}" />
                    </StackLayout>
                    
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="Durum:"
                               Style="{StaticResource LabelMedium}" />
                        <Label Text="{Binding Completed, Converter={StaticResource BoolToStatusConverter}}"
                               Style="{StaticResource BodyMedium}" />
                    </StackLayout>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10"
                          IsVisible="{Binding IsEditing}">
                        <StackLayout Spacing="4">
                            <Label Text="Teslim Tarihi"
                                   Style="{StaticResource LabelSmall}" />
                            <DatePicker Date="{Binding EditDueDate}"
                                        Format="dd.MM.yyyy" />
                        </StackLayout>
                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Hatırlatıcı"
                                   Style="{StaticResource LabelSmall}" />
                            <DatePicker Date="{Binding EditReminderDate}"
                                        Format="dd.MM.yyyy" />
                        </StackLayout>
                    </Grid>

                    <StackLayout Orientation="Horizontal" Spacing="10"
                                 IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                        <Label Text="Teslim:"
                               Style="{StaticResource LabelMedium}" />
                        <Label Text="{Binding DueDate, StringFormat='{0:dd.MM.yyyy}'}"
                               Style="{StaticResource BodyMedium}" />
                    </StackLayout>

                    <StackLayout Orientation="Horizontal" Spacing="10"
                                 IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                        <Label Text="Hatırlatma:"
                               Style="{StaticResource LabelMedium}" />
                        <Label Text="{Binding ReminderDate, StringFormat='{0:dd.MM.yyyy}'}"
                               Style="{StaticResource BodyMedium}" />
                    </StackLayout>
                    
                </StackLayout>
            </Frame>

            <!-- Voice Recordings -->
            <Frame Style="{StaticResource CardFrame}"
                   IsVisible="{Binding HasVoiceRecordings}">
                <StackLayout Spacing="10">
                    
                    <Label Text="Ses Kayıtları"
                           Style="{StaticResource TitleMedium}" />
                    
                    <CollectionView x:Name="VoiceCollection"
                                   ItemsSource="{Binding VoiceRecordings}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:VoiceRecording">
                                <Grid ColumnDefinitions="*,Auto,Auto" 
                                      RowDefinitions="Auto,Auto"
                                      Padding="0,10">
                                    
                                    <StackLayout Grid.Column="0"
                                                Grid.Row="0">
                                        <Label Text="{Binding FileName}"
                                               Style="{StaticResource BodyMedium}" />
                                        <Label Text="{Binding FormattedDuration}"
                                               Style="{StaticResource BodySmall}" />
                                    </StackLayout>
                                    
                                    <ProgressBar Grid.Column="0"
                                                 Grid.Row="1"
                                                 Progress="{Binding PlaybackProgress}"
                                                 ProgressColor="{StaticResource Primary}"
                                                 BackgroundColor="{StaticResource BorderPrimary}"
                                                 IsVisible="{Binding IsPlaying}" />
                                    
                                    <Button Grid.Column="1"
                                            Grid.Row="0"
                                            Text="{Binding PlayButtonText}"
                                            Command="{Binding Source={x:Reference VoiceCollection}, Path=BindingContext.PlayVoiceRecordingCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource IconButton}" />
                                    
                                    <Button Grid.Column="2"
                                            Grid.Row="0"
                                            Text="🗑️"
                                            Command="{Binding Source={x:Reference VoiceCollection}, Path=BindingContext.DeleteVoiceRecordingCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource IconButton}"
                                            BackgroundColor="{StaticResource Danger}" />
                                    
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                </StackLayout>
            </Frame>

            <!-- Actions -->
            <StackLayout Spacing="10">
                
                <Button Text="Düzenle"
                        Command="{Binding StartEditingCommand}"
                        IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}" />
                
                <Button Text="Kaydet"
                        Command="{Binding SaveChangesCommand}"
                        IsVisible="{Binding IsEditing}"
                        BackgroundColor="{StaticResource Success}" />
                
                <Button Text="İptal"
                        Command="{Binding CancelEditingCommand}"
                        IsVisible="{Binding IsEditing}"
                        Style="{StaticResource SecondaryButton}" />
                
                <Button Text="Sil"
                        Command="{Binding DeleteTodoCommand}"
                        BackgroundColor="{StaticResource Danger}" />
                
            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>