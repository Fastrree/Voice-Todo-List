<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TodoVoiceMaui.ViewModels"
             xmlns:models="clr-namespace:TodoVoiceMaui.Models"
             xmlns:converters="clr-namespace:TodoVoiceMaui.Converters"
             x:Class="TodoVoiceMaui.Views.TodoDetailPage"
             x:DataType="viewmodels:TodoDetailPageViewModel"
             Title="Görev Detayı"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid IsClippedToBounds="True">

        <!-- ATMOSFER -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <AppThemeBinding Light="{StaticResource AuroraBackgroundLight}" Dark="{StaticResource AuroraBackgroundDark}" />
            </Grid.Background>
        </Grid>

        <Grid Padding="24,14,24,12"
              RowDefinitions="Auto,*">

            <!-- BAŞLIK · geri butonu + bağlam -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,0,0,8">
                <!-- geri butonu (NavBar gizli olduğundan elle) -->
                <Border Grid.Column="0"
                        Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 999"
                        Padding="10,8"
                        VerticalOptions="Center">
                    <Border.Background>
                        <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}"
                           HorizontalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="GÖREV DETAYI"
                           Style="{StaticResource MicroLabel}"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                    <Label Text="{Binding Title}" Style="{StaticResource SubtitleMedium}" />
                </VerticalStackLayout>
            </Grid>

            <!-- İÇERİK -->
            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10">

                    <!-- BİLGİ -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Title}" Style="{StaticResource SubtitleMedium}" />
                            <Label Text="{Binding Description}" Style="{StaticResource BodyText}"
                                   IsVisible="{Binding Description, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="ÖNCELİK" Style="{StaticResource MicroLabel}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Priority}" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="DURUM" Style="{StaticResource MicroLabel}" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="{Binding Completed, Converter={StaticResource BoolToStatusConverter}}"
                                       Style="{StaticResource BodyText}" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                  IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                                <Label Grid.Column="0" Text="TESLİM" Style="{StaticResource MicroLabel}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding DueDate, StringFormat='{0:dd.MM.yyyy}'}"
                                       Style="{StaticResource BodyText}" VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsEditing}">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="TESLİM TARİHİ" Style="{StaticResource MicroLabel}" />
                                    <DatePicker Date="{Binding EditDueDate}" Format="dd.MM.yyyy" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="HATIRLATICI" Style="{StaticResource MicroLabel}" />
                                    <DatePicker Date="{Binding EditReminderDate}" Format="dd.MM.yyyy" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- SES KAYDI -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="YENİ SES KAYDI" Style="{StaticResource MicroLabel}" />
                            <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                                <Button Text="&#xE91F;" FontFamily="Segoe Fluent Icons"
                                        Command="{Binding StartRecordingCommand}"
                                        Style="{StaticResource IconButton}" WidthRequest="48" HeightRequest="48"
                                        CornerRadius="999" FontSize="18">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Text" Value="&#xE711;" />
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DarkDanger}}" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Label Text="{Binding RecordingDuration}" Style="{StaticResource BodyText}"
                                       FontAttributes="Bold" VerticalOptions="Center" />
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="8"
                                         IsVisible="{Binding HasPendingVoice}">
                                <Button Text="Kaydet" Command="{Binding SaveVoiceRecordingCommand}"
                                        IsEnabled="{Binding CanSaveVoice}" HeightRequest="38" CornerRadius="19" />
                                <Button Text="İptal" Command="{Binding ClearRecordingCommand}"
                                        Style="{StaticResource GhostButton}" HeightRequest="38" CornerRadius="19" />
                            </StackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- SES KAYITLARI -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12"
                            IsVisible="{Binding HasVoiceRecordings}">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="SES KAYITLARI" Style="{StaticResource MicroLabel}" />
                            <CollectionView x:Name="VoiceCollection" ItemsSource="{Binding VoiceRecordings}" HeightRequest="200">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:VoiceRecording">
                                        <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 16"
                                                Margin="0,3" Padding="12,8">
                                            <Border.Background>
                                                <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                                            </Border.Background>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                                    <Label Text="{Binding FileName}" Style="{StaticResource BodyText}" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding FormattedDuration}" Style="{StaticResource CaptionText}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1" Text="&#xE768;" FontFamily="Segoe Fluent Icons"
                                                        Command="{Binding Source={x:Reference VoiceCollection}, Path=BindingContext.PlayVoiceRecordingCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource IconButton}" WidthRequest="38" HeightRequest="38"
                                                        CornerRadius="999" FontSize="14" />
                                                <Button Grid.Column="2" Text="&#xE74D;" FontFamily="Segoe Fluent Icons"
                                                        Command="{Binding Source={x:Reference VoiceCollection}, Path=BindingContext.DeleteVoiceRecordingCommand}"
                                                        CommandParameter="{Binding .}" BackgroundColor="Transparent"
                                                        TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DarkDanger}}"
                                                        WidthRequest="38" HeightRequest="38" CornerRadius="999" FontSize="14" Padding="0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- AKSIYONLAR -->
                    <VerticalStackLayout Spacing="6">
                        <Button Text="Düzenle" Command="{Binding StartEditingCommand}"
                                IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}" />
                        <Button Text="Kaydet" Command="{Binding SaveChangesCommand}"
                                IsVisible="{Binding IsEditing}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource Success}}" />
                        <Button Text="İptal" Command="{Binding CancelEditingCommand}"
                                IsVisible="{Binding IsEditing}" Style="{StaticResource GhostButton}" />
                        <Button Text="Sil" Command="{Binding DeleteTodoCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DarkDanger}}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
