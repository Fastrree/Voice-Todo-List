<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TodoVoiceMaui.ViewModels"
             xmlns:converters="clr-namespace:TodoVoiceMaui.Converters"
             xmlns:services="clr-namespace:TodoVoiceMaui.Services"
             x:Class="TodoVoiceMaui.Views.SettingsPage"
             x:DataType="viewmodels:SettingsPageViewModel"
             Title="Ayarlar"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid IsClippedToBounds="True">

        <!-- ATMOSFER -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <AppThemeBinding Light="{StaticResource AuroraBackgroundLight}" Dark="{StaticResource AuroraBackgroundDark}" />
            </Grid.Background>
        </Grid>

        <Grid Padding="24,14,24,12"
              RowDefinitions="Auto,*"
              IsEnabled="{Binding IsSettingsLocked, Converter={StaticResource InverseBoolConverter}}">

            <!-- BAŞLIK -->
            <Grid Grid.Row="0" Padding="0,0,0,8">
                <VerticalStackLayout Spacing="0">
                    <Label Text="AYARLAR" Style="{StaticResource MicroLabel}"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                    <Label Text="Uygulama tercihleri" Style="{StaticResource SubtitleMedium}" />
                </VerticalStackLayout>
            </Grid>

            <!-- İÇERİK -->
            <ScrollView x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10">

                    <!-- PROFİL -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="PROFİL" Style="{StaticResource MicroLabel}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Ad Soyad" Style="{StaticResource CaptionText}" />
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                           CornerRadius="12" Padding="0" HasShadow="False">
                                        <Entry Text="{Binding FullName}" Placeholder="Adınız"
                                               Style="{StaticResource SearchEntry}" Margin="12,0" />
                                    </Frame>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="E-posta" Style="{StaticResource CaptionText}" />
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                           CornerRadius="12" Padding="0" HasShadow="False">
                                        <Entry Text="{Binding Email}" Placeholder="E-posta" Keyboard="Email"
                                               Style="{StaticResource SearchEntry}" Margin="12,0" />
                                    </Frame>
                                </VerticalStackLayout>
                            </Grid>
                            <Button Text="Profili Güncelle" Command="{Binding SaveProfileCommand}"
                                    HeightRequest="40" CornerRadius="20" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- TERCİHLER -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TERCİHLER" Style="{StaticResource MicroLabel}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Dil" Style="{StaticResource CaptionText}" />
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                           CornerRadius="12" Padding="0" HasShadow="False">
                                        <Picker x:Name="LanguagePicker" Title="Dil" ItemsSource="{Binding LanguageOptions}"
                                                ItemDisplayBinding="{Binding Value}" SelectedIndex="0"
                                                SelectedIndexChanged="OnLanguagePickerChanged"
                                                Style="{StaticResource InlinePicker}" />
                                    </Frame>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Tema" Style="{StaticResource CaptionText}" />
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                           CornerRadius="12" Padding="0" HasShadow="False">
                                        <Picker x:Name="ThemePicker" Title="Tema" ItemsSource="{Binding ThemeOptions}"
                                                ItemDisplayBinding="{Binding Value}" SelectedIndex="0"
                                                SelectedIndexChanged="OnThemePickerChanged"
                                                Style="{StaticResource InlinePicker}" />
                                    </Frame>
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" RowSpacing="4">
                                <Label Text="Bildirimler" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding EnableNotifications}"
                                        OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Sesli kayıt" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding EnableVoiceRecording}"
                                        OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Otomatik senkron" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding AutoSync}"
                                        OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Ses efektleri" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding EnableSoundEffects}"
                                        OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                            </Grid>
                            <Button Text="Tercihleri Kaydet" Command="{Binding SavePreferencesCommand}"
                                    HeightRequest="40" CornerRadius="20" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- SES TANIMA -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="SES TANIMA" Style="{StaticResource MicroLabel}" />
                                    <Label Text="Transkripsiyon kaynağı" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                            </Grid>

                            <!-- Kaynak seçici (çevrimdışı / bulut) -->
                            <Label Text="Kaynak" Style="{StaticResource CaptionText}" />
                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                   CornerRadius="12" Padding="0" HasShadow="False">
                                <Picker x:Name="SpeechProviderPicker" Title="Kaynak"
                                        ItemsSource="{Binding SpeechProviders}"
                                        ItemDisplayBinding="{Binding DisplayName}" SelectedIndex="0"
                                        SelectedIndexChanged="OnSpeechProviderPickerChanged"
                                        Style="{StaticResource InlinePicker}" />
                            </Frame>

                            <!-- Seçili kaynağın detay kartı -->
                            <Border Stroke="{AppThemeBinding Light={StaticResource BorderDefault}, Dark={StaticResource DarkBorderDefault}}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12,10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource DarkSurfaceMuted}}">
                                <Label Text="{Binding ProviderDetailText}" Style="{StaticResource CaptionText}"
                                       LineBreakMode="WordWrap" />
                            </Border>

                            <Label Text="{Binding ProviderStatusText}" Style="{StaticResource CaptionText}"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource SecondaryDark}, Dark={StaticResource DarkSecondary}}" />

                            <!-- API anahtarı (yalnız bulut kaynaklar) -->
                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsApiKeyVisible}">
                                <Label Text="API Anahtarı" Style="{StaticResource CaptionText}" />
                                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                       CornerRadius="12" Padding="0" HasShadow="False">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Entry Text="{Binding ProviderApiKey}"
                                               IsPassword="{Binding IsApiKeyMasked}"
                                               Placeholder="sk-... / API key"
                                               Style="{StaticResource SearchEntry}" Margin="12,0"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="&#xE7B3;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                                Command="{Binding ToggleApiKeyVisibilityCommand}"
                                                IsVisible="{Binding IsKeyLocked, Converter={StaticResource InverseBoolConverter}}"
                                                BackgroundColor="Transparent" BorderWidth="0"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                                WidthRequest="40" HeightRequest="40" Padding="0" CornerRadius="20"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Frame>

                                <!-- Bölge (yalnız Azure) -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsRegionRequired}">
                                    <Label Text="Bölge (Azure Speech resource)" Style="{StaticResource CaptionText}" />
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                           CornerRadius="12" Padding="0" HasShadow="False">
                                        <Entry Text="{Binding ProviderRegion}" Placeholder="westeurope / northeurope / turkiyecentral"
                                               Style="{StaticResource SearchEntry}" Margin="12,0" />
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Biyometrik kilit (Windows Hello) -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,2">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Windows Hello ile kilitle" Style="{StaticResource BodyText}" />
                                        <Label Text="{Binding BiometricStatusText}" Style="{StaticResource CaptionText}"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource DarkTextTertiary}}" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" VerticalOptions="Center"
                                            IsToggled="{Binding IsBiometricLockEnabled, Mode=OneWay}"
                                            IsEnabled="{Binding IsBiometricAvailable}"
                                            Toggled="OnBiometricLockToggled"
                                            OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                                </Grid>
                                <Button Text="&#xE8F7; Kilidi Aç (Windows Hello)" Command="{Binding UnlockApiKeyCommand}"
                                        IsVisible="{Binding IsKeyLocked}"
                                        Style="{StaticResource GhostButton}" HeightRequest="36" CornerRadius="18" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Text="Anahtarı Kaydet" Command="{Binding SaveProviderApiKeyCommand}"
                                            HeightRequest="38" CornerRadius="19" />
                                    <Button Grid.Column="1" Text="Bağlantıyı Test Et"
                                            Command="{Binding TestProviderConnectionCommand}"
                                            IsEnabled="{Binding IsProviderTesting, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource GhostButton}" HeightRequest="38" CornerRadius="19" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Çevrimdışı model seçimi (yalnız çevrimdışı kaynak) -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsOfflineProvider}">
                                <Label Text="Çevrimdışı Model (4 katman)" Style="{StaticResource CaptionText}" />
                                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                       CornerRadius="12" Padding="0" HasShadow="False">
                                    <Picker x:Name="SttModelPicker" Title="Model" ItemsSource="{Binding SttModels}"
                                            ItemDisplayBinding="{Binding DisplayName}" SelectedIndex="0"
                                            SelectedIndexChanged="OnSttModelPickerChanged"
                                            Style="{StaticResource InlinePicker}" />
                                </Frame>
                                <Button Text="&#xE718; Model Yönetimi — İndir / Sil / Detay"
                                        Command="{Binding ShowModelManagementCommand}"
                                        Style="{StaticResource GhostButton}" HeightRequest="36" CornerRadius="18" />

                                <!-- Seçili modelin detay kartı -->
                                <Border Stroke="{AppThemeBinding Light={StaticResource BorderDefault}, Dark={StaticResource DarkBorderDefault}}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="12,10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource DarkSurfaceMuted}}">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                                            <Border Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                    Padding="8,3"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource DarkAccentSoft}}">
                                                <Label Text="{Binding SelectedSttModel.SizeLabel}" Style="{StaticResource CaptionText}"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource AccentDark}, Dark={StaticResource DarkAccent}}" />
                                            </Border>
                                            <Border Grid.Column="1" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                    Padding="8,3"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SecondarySoft}, Dark={StaticResource DarkSecondarySoft}}">
                                                <Label Text="{Binding SelectedSttModel.SpeedLabel}" Style="{StaticResource CaptionText}"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource SecondaryDark}, Dark={StaticResource DarkSecondary}}" />
                                            </Border>
                                            <Border Grid.Column="2" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                    Padding="8,3"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource VoiceReadySoft}, Dark={StaticResource DarkVoiceReadySoft}}">
                                                <Label Text="{Binding SelectedSttModel.AccuracyLabel}" Style="{StaticResource CaptionText}"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource VoiceReady}, Dark={StaticResource DarkSuccess}}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding SelectedSttModel.Description}"
                                               Style="{StaticResource CaptionText}"
                                               LineBreakMode="WordWrap" />

                                        <Label Text="{Binding SelectedSttModel.RamLabel}" Style="{StaticResource CaptionText}"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                        <Label Text="{Binding SelectedSttModel.WerLabel}" Style="{StaticResource CaptionText}"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                        <Label Text="{Binding SelectedSttModel.QuantizationLabel}" Style="{StaticResource CaptionText}"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                        <Label Text="{Binding SelectedSttModel.RecommendationText}" Style="{StaticResource CaptionText}"
                                               FontAttributes="Bold" LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource AccentDark}, Dark={StaticResource DarkAccent}}" />

                                        <Label Text="{Binding SttInstalledInfo}" Style="{StaticResource CaptionText}"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryDark}, Dark={StaticResource DarkSecondary}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- İndirme durumu -->
                                <Grid IsVisible="{Binding IsSttDownloading}">
                                    <ProgressBar Progress="{Binding SttDownloadProgress}" HeightRequest="4"
                                                 ProgressColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                                </Grid>
                                <Label Text="{Binding SttStatusText}" Style="{StaticResource CaptionText}"
                                       IsVisible="{Binding IsSttDownloading}" />

                                <Button Text="Bu Modeli İndir ve Kullan" Command="{Binding SwitchSttModelCommand}"
                                        HeightRequest="40" CornerRadius="20"
                                        IsVisible="{Binding IsSttDownloading, Converter={StaticResource InverseBoolConverter}}" />

                                <!-- İndirme sürerken: buton yeşil ilerleme çubuğuna dönüşür; tıkla → detay modalı -->
                                <Border IsVisible="{Binding IsSttDownloading}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 20" HeightRequest="40"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource DarkSurfaceMuted}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowDownloadDetailsCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid Padding="14,0">
                                        <ProgressBar Progress="{Binding SttDownloadProgress}" HeightRequest="7"
                                                     VerticalOptions="Center"
                                                     ProgressColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource DarkSuccess}}" />
                                        <Label Text="{Binding SttDownloadInlineText}" Style="{StaticResource CaptionText}"
                                               FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <Label Text="Katalog: Çevrimdışı 4 katman (190MB→3,1GB) + OpenAI, Groq, Fireworks, Deepgram, ElevenLabs, AssemblyAI, Google (Chirp 2), Azure AI Speech (anahtar + bölge). Cloudflare, Soniox, Sestek yakında. Anahtarlar Windows Vault'ta şifreli; bulut başarısız olursa otomatik çevrimdışı Whisper'a düşülür. İndirme çubuğuna tıklayınca ayrıntılı modal açılır."
                                   Style="{StaticResource CaptionText}" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource DarkTextTertiary}}" />

                            <!-- CANLI KONSOL: bağlantı testleri + indirme + çevrimdışı işlemler akar -->
                            <Border StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12,10"
                                    Stroke="#1F2937"
                                    BackgroundColor="#0B1220">
                                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="&#xE756; CANLI KONSOL" FontFamily="SoraSemiBold" FontSize="11"
                                               TextColor="#4ADE80" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="Temizle"
                                                Command="{Binding ClearTestConsoleCommand}"
                                                BackgroundColor="Transparent" BorderWidth="0"
                                                TextColor="#9CA3AF" FontSize="11"
                                                HeightRequest="24" Padding="6,0" CornerRadius="12" />
                                    </Grid>

                                    <!-- FİLTRE ÇİPLERİ -->
                                    <HorizontalStackLayout Grid.Row="1" Spacing="6">
                                        <Button Text="Tümü" FontSize="10" HeightRequest="24" CornerRadius="12" Padding="10,0"
                                                BackgroundColor="Transparent" TextColor="#9CA3AF" BorderWidth="1" BorderColor="#1F2937"
                                                Command="{Binding SetConsoleFilterCommand}" CommandParameter="{x:Static services:SttConsoleFilter.All}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding ConsoleFilter}" Value="{x:Static services:SttConsoleFilter.All}">
                                                    <Setter Property="BackgroundColor" Value="#60A5FA" />
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                    <Setter Property="BorderColor" Value="#60A5FA" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="✓ Başarı" FontSize="10" HeightRequest="24" CornerRadius="12" Padding="10,0"
                                                BackgroundColor="Transparent" TextColor="#9CA3AF" BorderWidth="1" BorderColor="#1F2937"
                                                Command="{Binding SetConsoleFilterCommand}" CommandParameter="{x:Static services:SttConsoleFilter.Success}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding ConsoleFilter}" Value="{x:Static services:SttConsoleFilter.Success}">
                                                    <Setter Property="BackgroundColor" Value="#4ADE80" />
                                                    <Setter Property="TextColor" Value="#0B1220" />
                                                    <Setter Property="BorderColor" Value="#4ADE80" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="✗ Hata" FontSize="10" HeightRequest="24" CornerRadius="12" Padding="10,0"
                                                BackgroundColor="Transparent" TextColor="#9CA3AF" BorderWidth="1" BorderColor="#1F2937"
                                                Command="{Binding SetConsoleFilterCommand}" CommandParameter="{x:Static services:SttConsoleFilter.Errors}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding ConsoleFilter}" Value="{x:Static services:SttConsoleFilter.Errors}">
                                                    <Setter Property="BackgroundColor" Value="#F87171" />
                                                    <Setter Property="TextColor" Value="#0B1220" />
                                                    <Setter Property="BorderColor" Value="#F87171" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="⚠ Uyarı" FontSize="10" HeightRequest="24" CornerRadius="12" Padding="10,0"
                                                BackgroundColor="Transparent" TextColor="#9CA3AF" BorderWidth="1" BorderColor="#1F2937"
                                                Command="{Binding SetConsoleFilterCommand}" CommandParameter="{x:Static services:SttConsoleFilter.Warnings}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding ConsoleFilter}" Value="{x:Static services:SttConsoleFilter.Warnings}">
                                                    <Setter Property="BackgroundColor" Value="#FBBF24" />
                                                    <Setter Property="TextColor" Value="#0B1220" />
                                                    <Setter Property="BorderColor" Value="#FBBF24" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </HorizontalStackLayout>

                                    <ScrollView x:Name="TestConsoleScroll" Grid.Row="2" HeightRequest="120"
                                                VerticalScrollBarVisibility="Never">
                                        <Label FormattedText="{Binding TestConsoleFormatted}"
                                               LineBreakMode="WordWrap"
                                               VerticalOptions="Start" />
                                    </ScrollView>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- SENKRONİZASYON -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="SENKRONİZASYON" Style="{StaticResource MicroLabel}" />
                                    <Label Text="{Binding SyncStatusText}" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                                    <Label Text="{Binding LastSyncText}" Style="{StaticResource CaptionText}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}" />
                            </Grid>
                            <Button Text="Şimdi Senkronize Et" Command="{Binding SyncNowCommand}"
                                    Style="{StaticResource GhostButton}" HeightRequest="40" CornerRadius="20" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- İŞLEMLER -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="İŞLEMLER" Style="{StaticResource MicroLabel}" />
                            <Button Text="Yerel Verileri Temizle" Command="{Binding ClearLocalDataCommand}"
                                    Style="{StaticResource GhostButton}" HeightRequest="38" CornerRadius="19" />
                            <Button Text="Hakkında" Command="{Binding ShowAboutCommand}"
                                    Style="{StaticResource GhostButton}" HeightRequest="38" CornerRadius="19" />
                            <Button Text="Çıkış Yap" Command="{Binding SignOutCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DarkRecordingSoft}}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentContrast}, Dark={StaticResource Danger}}"
                                    HeightRequest="38" CornerRadius="19" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- 🔒 KİLİT OVERLAY (biyometrik kilit açıkken Ayarlar'a girişte) -->
        <Grid IsVisible="{Binding IsSettingsLocked}"
              BackgroundColor="{AppThemeBinding Light=#E6F8FAFC, Dark=#E60A0A0F}">
            <Border WidthRequest="360"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="24,22"
                    Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.Background>
                    <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowLg}, Dark={StaticResource DarkShadowLg}}"
                            Radius="28" Opacity="0.55" Offset="0,10" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center" WidthRequest="300">
                    <Border WidthRequest="64" HeightRequest="64" HorizontalOptions="Center"
                            StrokeThickness="0" StrokeShape="RoundRectangle 32"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}">
                        <Label Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="28"
                               TextColor="{AppThemeBinding Light={StaticResource AccentContrast}, Dark={StaticResource DarkBackground}}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="AYARLAR KİLİTLİ" Style="{StaticResource MicroLabel}" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                    <Label Text="Bu bölüm Windows Hello koruması altında."
                           FontFamily="SoraSemiBold" FontSize="16" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                    <Label Text="API anahtarlarını görmek ve bağlantı testlerini çalıştırmak için kimliğini doğrula."
                           Style="{StaticResource CaptionText}" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Button Text="&#xE8F7; Windows Hello ile Aç" Command="{Binding UnlockSettingsCommand}"
                            HeightRequest="44" CornerRadius="22" />
                    <Label Text="Parmak izi / yüz / PIN kullanılabilir."
                           Style="{StaticResource CaptionText}" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource DarkTextTertiary}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
