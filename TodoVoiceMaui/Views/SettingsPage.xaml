<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TodoVoiceMaui.ViewModels"
             xmlns:converters="clr-namespace:TodoVoiceMaui.Converters"
             x:Class="TodoVoiceMaui.Views.SettingsPage"
             x:DataType="viewmodels:SettingsPageViewModel"
             Title="Ayarlar"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid IsClippedToBounds="True">

        <!-- ATMOSFER -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <AppThemeBinding Light="{StaticResource AuroraBackgroundLight}" Dark="{StaticResource AuroraBackgroundDark}" />
            </Grid.Background>
        </Grid>

        <Grid Padding="24,14,24,12"
              RowDefinitions="Auto,*">

            <!-- BAŞLIK -->
            <Grid Grid.Row="0" Padding="0,0,0,8">
                <VerticalStackLayout Spacing="0">
                    <Label Text="AYARLAR" Style="{StaticResource MicroLabel}"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                    <Label Text="Uygulama tercihleri" Style="{StaticResource SubtitleMedium}" />
                </VerticalStackLayout>
            </Grid>

            <!-- İÇERİK -->
            <ScrollView x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10">

                    <!-- PROFİL -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="PROFİL" Style="{StaticResource MicroLabel}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Ad Soyad" Style="{StaticResource CaptionText}" />
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                           CornerRadius="12" Padding="0" HasShadow="False">
                                        <Entry Text="{Binding FullName}" Placeholder="Adınız"
                                               Style="{StaticResource SearchEntry}" Margin="12,0" />
                                    </Frame>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="E-posta" Style="{StaticResource CaptionText}" />
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                           CornerRadius="12" Padding="0" HasShadow="False">
                                        <Entry Text="{Binding Email}" Placeholder="E-posta" Keyboard="Email"
                                               Style="{StaticResource SearchEntry}" Margin="12,0" />
                                    </Frame>
                                </VerticalStackLayout>
                            </Grid>
                            <Button Text="Profili Güncelle" Command="{Binding SaveProfileCommand}"
                                    HeightRequest="40" CornerRadius="20" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- TERCİHLER -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TERCİHLER" Style="{StaticResource MicroLabel}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Dil" Style="{StaticResource CaptionText}" />
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                           CornerRadius="12" Padding="0" HasShadow="False">
                                        <Picker x:Name="LanguagePicker" Title="Dil" ItemsSource="{Binding LanguageOptions}"
                                                ItemDisplayBinding="{Binding Value}" SelectedIndex="0"
                                                SelectedIndexChanged="OnLanguagePickerChanged"
                                                Style="{StaticResource InlinePicker}" />
                                    </Frame>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Tema" Style="{StaticResource CaptionText}" />
                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                                           CornerRadius="12" Padding="0" HasShadow="False">
                                        <Picker x:Name="ThemePicker" Title="Tema" ItemsSource="{Binding ThemeOptions}"
                                                ItemDisplayBinding="{Binding Value}" SelectedIndex="0"
                                                SelectedIndexChanged="OnThemePickerChanged"
                                                Style="{StaticResource InlinePicker}" />
                                    </Frame>
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" RowSpacing="4">
                                <Label Text="Bildirimler" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding EnableNotifications}"
                                        OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Sesli kayıt" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding EnableVoiceRecording}"
                                        OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Otomatik senkron" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding AutoSync}"
                                        OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Ses efektleri" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding EnableSoundEffects}"
                                        OnColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                            </Grid>
                            <Button Text="Tercihleri Kaydet" Command="{Binding SavePreferencesCommand}"
                                    HeightRequest="40" CornerRadius="20" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- SENKRONİZASYON -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="SENKRONİZASYON" Style="{StaticResource MicroLabel}" />
                                    <Label Text="{Binding SyncStatusText}" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                                    <Label Text="{Binding LastSyncText}" Style="{StaticResource CaptionText}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}" />
                            </Grid>
                            <Button Text="Şimdi Senkronize Et" Command="{Binding SyncNowCommand}"
                                    Style="{StaticResource GhostButton}" HeightRequest="40" CornerRadius="20" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- İŞLEMLER -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,12">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="İŞLEMLER" Style="{StaticResource MicroLabel}" />
                            <Button Text="Yerel Verileri Temizle" Command="{Binding ClearLocalDataCommand}"
                                    Style="{StaticResource GhostButton}" HeightRequest="38" CornerRadius="19" />
                            <Button Text="Hakkında" Command="{Binding ShowAboutCommand}"
                                    Style="{StaticResource GhostButton}" HeightRequest="38" CornerRadius="19" />
                            <Button Text="Çıkış Yap" Command="{Binding SignOutCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DarkRecordingSoft}}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentContrast}, Dark={StaticResource Danger}}"
                                    HeightRequest="38" CornerRadius="19" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
