<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TodoVoiceMaui.ViewModels"
             xmlns:models="clr-namespace:TodoVoiceMaui.Models"
             xmlns:converters="clr-namespace:TodoVoiceMaui.Converters"
             x:Class="TodoVoiceMaui.Views.TodoListPage"
             x:DataType="viewmodels:TodoListPageViewModel"
             Title="Görevler"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid IsClippedToBounds="True">

        <!-- KATMAN 0 · AURORA ATMOSFER -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <AppThemeBinding Light="{StaticResource AuroraBackgroundLight}" Dark="{StaticResource AuroraBackgroundDark}" />
            </Grid.Background>
        </Grid>

        <!-- ambient glow · şeftali/indigo (üst sol) — Light'ta pastel, Dark'ta güçlü -->
        <BoxView WidthRequest="420" HeightRequest="420" CornerRadius="210"
                 HorizontalOptions="Start" VerticalOptions="Start"
                 TranslationX="-130" TranslationY="-150"
                 Opacity="{AppThemeBinding Light=0.36, Dark=0.45}"
                 Color="Transparent"
                 InputTransparent="True">
            <BoxView.Background>
                <AppThemeBinding Light="{StaticResource GlowPeachLight}" Dark="{StaticResource GlowIndigoDark}" />
            </BoxView.Background>
        </BoxView>

        <!-- ambient glow · turkuaz/mor (alt sağ) -->
        <BoxView WidthRequest="420" HeightRequest="420" CornerRadius="210"
                 HorizontalOptions="End" VerticalOptions="End"
                 TranslationX="150" TranslationY="180"
                 Opacity="{AppThemeBinding Light=0.36, Dark=0.45}"
                 Color="Transparent"
                 InputTransparent="True">
            <BoxView.Background>
                <AppThemeBinding Light="{StaticResource GlowSkyLight}" Dark="{StaticResource GlowTealDark}" />
            </BoxView.Background>
        </BoxView>

        <!-- KATMAN 1 · İÇERİK (pencere sabit genişlikte → tam genişlik) -->
        <Grid Padding="24,14,24,12"
              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

            <!-- BAŞLIK + senkron durumu -->
            <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,0,0,10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="GÖREVLER"
                           Style="{StaticResource MicroLabel}"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                    <Label Text="Görevlerini sesle yönet"
                           Style="{StaticResource SubtitleMedium}" />
                </VerticalStackLayout>

                <!-- senkron chip · yalnızca senkronizasyon sırasında -->
                <Border Grid.Column="1"
                        IsVisible="{Binding IsSyncing}"
                        Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 999"
                        Padding="10,5"
                        VerticalOptions="Center">
                    <Border.Background>
                        <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                    </Border.Background>
                    <StackLayout Orientation="Horizontal" Spacing="6">
                        <ActivityIndicator IsRunning="{Binding IsSyncing}"
                                           Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}"
                                           WidthRequest="12" HeightRequest="12" />
                        <Label Text="{Binding SyncStatus}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                               VerticalOptions="Center" />
                    </StackLayout>
                </Border>
            </Grid>

            <!-- ARAMA -->
            <Grid x:Name="SearchBox" Grid.Row="1" Padding="0,0,0,8">
                <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">
                    <Border.Background>
                        <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                    </Border.Background>
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="&#xE721;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource DarkTextTertiary}}"
                               VerticalOptions="Center"
                               Margin="14,0,6,0" />
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Ara..."
                               Style="{StaticResource SearchEntry}"
                               Margin="0,0,14,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- FİLTRELER -->
            <ScrollView x:Name="FiltersScroll" Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Margin="0,0,0,8">
                <StackLayout Orientation="Horizontal" Spacing="6">
                    <Button Text="Tümü" Command="{Binding ChangeFilterCommand}" CommandParameter="all"
                            Style="{StaticResource FilterChip}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="all">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                                <Setter Property="TextColor" Value="{StaticResource AccentContrast}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Bekleyen" Command="{Binding ChangeFilterCommand}" CommandParameter="pending"
                            Style="{StaticResource FilterChip}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="pending">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                                <Setter Property="TextColor" Value="{StaticResource AccentContrast}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Tamamlanan" Command="{Binding ChangeFilterCommand}" CommandParameter="completed"
                            Style="{StaticResource FilterChip}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="completed">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                                <Setter Property="TextColor" Value="{StaticResource AccentContrast}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Sesli" Command="{Binding ChangeFilterCommand}" CommandParameter="with_voice"
                            Style="{StaticResource FilterChip}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="with_voice">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                                <Setter Property="TextColor" Value="{StaticResource AccentContrast}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </StackLayout>
            </ScrollView>

            <!-- LİSTE · doğal scroll -->
            <RefreshView x:Name="TodosRefresh" Grid.Row="3"
                         Command="{Binding RefreshCommand}"
                         IsRefreshing="{Binding IsLoading}">

                <CollectionView x:Name="TodosCollection"
                                ItemsSource="{Binding FilteredTodos}"
                                BackgroundColor="Transparent">
                    <CollectionView.EmptyView>
                        <Border Stroke="Transparent"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="0,20">
                            <Border.Background>
                                <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                            </Border.Background>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="&#xE721;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="32"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource DarkTextTertiary}}" />
                                <Label Text="Görev bulunamadı"
                                       Style="{StaticResource SubtitleMedium}"
                                       HorizontalOptions="Center" />
                                <Label Text="Yeni görev ekleyin veya filtreleri sıfırlayın"
                                       Style="{StaticResource CaptionText}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TodoListItem">
                            <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="12,10"
                                    Margin="0,3">
                                <Border.Background>
                                    <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                                </Border.Background>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference TodosCollection}, Path=BindingContext.OpenTodoDetailCommand}"
                                                          CommandParameter="{Binding .}" />
                                    <PointerGestureRecognizer PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Completed}" VerticalOptions="Start">
                                        <CheckBox.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference TodosCollection}, Path=BindingContext.ToggleTodoCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </CheckBox.GestureRecognizers>
                                    </CheckBox>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Title}" Style="{StaticResource SubtitleMedium}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Completed}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Description}"
                                               Style="{StaticResource CaptionText}"
                                               IsVisible="{Binding Description, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                            <Label Text="{Binding PriorityIcon}" FontSize="10" VerticalOptions="Center" />
                                            <Label Text="{Binding Priority}" Style="{StaticResource MicroLabel}" />
                                            <Label Text="&#xE91F;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="10"
                                                   IsVisible="{Binding HasVoiceRecording}"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}" />
                                            <Label Text="&#xE8D5;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="10"
                                                   IsVisible="{Binding HasReminder}"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource DarkWarning}}" />
                                            <Label Text="{Binding ReminderLabel}"
                                                   Style="{StaticResource MicroLabel}"
                                                   IsVisible="{Binding HasReminder}"
                                                   VerticalOptions="Center" />
                                        </StackLayout>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding StatusIcon}" FontSize="12" VerticalOptions="Start" />
                                    <Button Grid.Column="3"
                                            Text="&#xE74D;"
                                            FontFamily="Segoe Fluent Icons"
                                            Command="{Binding Source={x:Reference TodosCollection}, Path=BindingContext.DeleteTodoCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DarkDanger}}"
                                            WidthRequest="36" HeightRequest="36"
                                            CornerRadius="999" FontSize="12" Padding="0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </RefreshView>

            <!-- SES DURUMU · yalnızca voice flow aktifken (kayıt/çeviri ilerlemesi) -->
            <Border x:Name="VoiceStatus" Grid.Row="4"
                    IsVisible="{Binding IsVoiceFlowActive}"
                    Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 999"
                    Padding="10,6"
                    Margin="0,0,0,6">
                <Border.Background>
                    <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                </Border.Background>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <ActivityIndicator IsRunning="{Binding IsVoiceFlowActive}"
                                       Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}"
                                       WidthRequest="14" HeightRequest="14" />
                    <Label Grid.Column="1"
                           Text="{Binding SpeechStatus}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- ALT BAR · ekleme (sabit) -->
            <Border x:Name="BottomBar" Grid.Row="5"
                    Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="10,8"
                    Margin="0,8,0,0">
                <Border.Background>
                    <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            Background="{AppThemeBinding Light={StaticResource GlassSurfaceLight}, Dark={StaticResource GlassSurfaceDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <Entry Text="{Binding NewTodoTitle}"
                               Placeholder="Yeni görev ekle..."
                               Style="{StaticResource SearchEntry}"
                               Margin="12,0" />
                    </Border>
                    <Button x:Name="HistoryButton" Grid.Column="1"
                            Text="&#xE81C;"
                            FontFamily="Segoe Fluent Icons"
                            Clicked="OnHistoryClicked"
                            BackgroundColor="Transparent" BorderWidth="0"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                            WidthRequest="42" HeightRequest="42"
                            CornerRadius="999" FontSize="16"
                            ToolTipProperties.Text="Transkripsiyon geçmişi" />
                    <Button x:Name="MicButton" Grid.Column="2"
                            Text="&#xE91F;"
                            FontFamily="Segoe Fluent Icons"
                            Command="{Binding StartSpeechToTextCommand}"
                            Style="{StaticResource IconButton}"
                            WidthRequest="42" HeightRequest="42"
                            CornerRadius="999" FontSize="16">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSpeechListening}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="3"
                            Text="&#xE710;"
                            FontFamily="Segoe Fluent Icons"
                            Command="{Binding AddTodoCommand}"
                            Style="{StaticResource IconButton}"
                            WidthRequest="42" HeightRequest="42"
                            CornerRadius="999" FontSize="16"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
                </Grid>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
