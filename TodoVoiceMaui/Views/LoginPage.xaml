<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TodoVoiceMaui.ViewModels"
             x:Class="TodoVoiceMaui.Views.LoginPage"
             x:DataType="viewmodels:LoginPageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Primary}">

    <ScrollView>
        <Grid RowDefinitions="*, Auto, *" 
              Padding="40,60,40,40">
            
            <!-- Header -->
            <StackLayout Grid.Row="0" 
                        VerticalOptions="End"
                        HorizontalOptions="Center"
                        Spacing="20">
                
                <!-- App Logo/Icon -->
                <Label Text="🎤" 
                       FontSize="80"
                       HorizontalOptions="Center" />
                
                <Label Text="{Binding TitleText}"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                
                <Label Text="{Binding SubtitleText}"
                       FontSize="16"
                       TextColor="White"
                       Opacity="0.8"
                       HorizontalOptions="Center" />
                
            </StackLayout>

            <!-- Login Form -->
            <StackLayout Grid.Row="1" 
                        VerticalOptions="Center"
                        Spacing="20"
                        Margin="0,60,0,0">
                
                <!-- Error Message -->
                <Frame IsVisible="{Binding HasError}"
                       BackgroundColor="{StaticResource Danger}"
                       Padding="15"
                       CornerRadius="10"
                       HasShadow="False">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="White"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </Frame>

                <!-- Email Input -->
                <Frame BackgroundColor="White" 
                       Padding="0"
                       CornerRadius="25"
                       HasShadow="False">
                    <Entry x:Name="EmailEntry"
                           Text="{Binding Email}"
                           Placeholder="E-posta adresiniz"
                           Keyboard="Email"
                           FontSize="16"
                           Margin="20,0" />
                </Frame>

                <!-- Password Input -->
                <Frame BackgroundColor="White" 
                       Padding="0"
                       CornerRadius="25"
                       HasShadow="False">
                    <Entry Text="{Binding Password}"
                           Placeholder="Şifreniz"
                           IsPassword="True"
                           FontSize="16"
                           Margin="20,0" />
                </Frame>

                <!-- Confirm Password (Signup only) -->
                <Frame BackgroundColor="White" 
                       Padding="0"
                       CornerRadius="25"
                       HasShadow="False"
                       IsVisible="{Binding IsSignupMode}">
                    <Entry Text="{Binding ConfirmPassword}"
                           Placeholder="Şifre onayı"
                           IsPassword="True"
                           FontSize="16"
                           Margin="20,0" />
                </Frame>

                <!-- Primary Action Button -->
                <Button x:Name="PrimaryButton"
                        Text="{Binding PrimaryButtonText}"
                        BackgroundColor="White"
                        TextColor="{StaticResource Primary}"
                        FontSize="18"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="50"
                        Margin="0,20,0,0">
                    
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" 
                                   Binding="{Binding IsLoading}" 
                                   Value="True">
                            <Setter Property="Text" Value="Yükleniyor..." />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Secondary Action Button -->
                <Button x:Name="ToggleModeButton"
                        Text="{Binding SecondaryButtonText}"
                        Command="{Binding ToggleModeCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="14"
                        Margin="0,10,0,0">
                    
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" 
                                   Binding="{Binding IsLoading}" 
                                   Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </StackLayout>

            <!-- Footer -->
            <StackLayout Grid.Row="2" 
                        VerticalOptions="End"
                        HorizontalOptions="Center">
                <Label Text="Todo Voice v1.0"
                       FontSize="12"
                       TextColor="White"
                       Opacity="0.6"
                       HorizontalOptions="Center" />
            </StackLayout>

        </Grid>
    </ScrollView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Converters would be defined here in a real app -->
            <!-- For now, we'll handle this in code-behind -->
        </ResourceDictionary>
    </ContentPage.Resources>

</ContentPage>