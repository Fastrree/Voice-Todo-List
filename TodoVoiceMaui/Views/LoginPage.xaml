<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TodoVoiceMaui.ViewModels"
             x:Class="TodoVoiceMaui.Views.LoginPage"
             x:DataType="viewmodels:LoginPageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource DarkBackground}}">

    <Grid IsClippedToBounds="True">

        <!-- ATMOSFER -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <AppThemeBinding Light="{StaticResource AuroraBackgroundLight}" Dark="{StaticResource AuroraBackgroundDark}" />
            </Grid.Background>
        </Grid>

        <!-- glow · lavanta/indigo (üst) + turkuaz (alt)
             Light: görünür pastel aurora; Dark: güçlü ambient -->
        <BoxView WidthRequest="400" HeightRequest="400" CornerRadius="200"
                 HorizontalOptions="Center" VerticalOptions="Start"
                 TranslationY="-100"
                 Opacity="{AppThemeBinding Light=0.38, Dark=0.4}"
                 Color="Transparent" InputTransparent="True">
            <BoxView.Background>
                <AppThemeBinding Light="{StaticResource GlowLavenderLight}" Dark="{StaticResource GlowIndigoDark}" />
            </BoxView.Background>
        </BoxView>
        <BoxView WidthRequest="380" HeightRequest="380" CornerRadius="190"
                 HorizontalOptions="End" VerticalOptions="End"
                 TranslationX="140" TranslationY="160"
                 Opacity="{AppThemeBinding Light=0.36, Dark=0.4}"
                 Color="Transparent" InputTransparent="True">
            <BoxView.Background>
                <AppThemeBinding Light="{StaticResource GlowMintLight}" Dark="{StaticResource GlowTealDark}" />
            </BoxView.Background>
        </BoxView>

        <!-- MERKEZ: login kartı (pencere sabit genişlikte → tam genişlik) -->
        <Grid RowDefinitions="*,Auto,*"
              Padding="32,0">

            <!-- ÜST: marka -->
            <VerticalStackLayout Grid.Row="0" Spacing="4" VerticalOptions="End" HorizontalOptions="Center">
                <Label Text="🎤" FontSize="48" HorizontalOptions="Center" />
                <Label Text="{Binding TitleText}" FontFamily="SoraBold" FontSize="28"
                       LineHeight="1.2" HorizontalOptions="Center" />
                <Label Text="{Binding SubtitleText}" Style="{StaticResource CaptionText}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- ORTA: form -->
            <VerticalStackLayout Grid.Row="1" Spacing="12" VerticalOptions="Center">

                <Frame IsVisible="{Binding HasError}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DarkDanger}}"
                       Padding="12" CornerRadius="12" HasShadow="False">
                    <Label Text="{Binding ErrorMessage}" TextColor="White"
                           FontSize="13" HorizontalTextAlignment="Center" />
                </Frame>

                <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0">
                    <Border.Background>
                        <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                    </Border.Background>
                    <Entry Text="{Binding Email}" Placeholder="E-posta" Keyboard="Email"
                           Style="{StaticResource SearchEntry}" Margin="16,0" />
                </Border>

                <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0">
                    <Border.Background>
                        <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                    </Border.Background>
                    <Entry Text="{Binding Password}" Placeholder="Şifre" IsPassword="True"
                           Style="{StaticResource SearchEntry}" Margin="16,0" />
                </Border>

                <Border Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0"
                        IsVisible="{Binding IsSignupMode}">
                    <Border.Background>
                        <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                    </Border.Background>
                    <Entry Text="{Binding ConfirmPassword}" Placeholder="Şifre onayı" IsPassword="True"
                           Style="{StaticResource SearchEntry}" Margin="16,0" />
                </Border>

                <Button x:Name="PrimaryButton" Text="{Binding PrimaryButtonText}"
                        HeightRequest="48" CornerRadius="24" Margin="0,8,0,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Text" Value="Yükleniyor..." />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="{Binding SecondaryButtonText}"
                        Command="{Binding ToggleModeCommand}"
                        Style="{StaticResource GhostButton}"
                        HeightRequest="40" CornerRadius="20" />

            </VerticalStackLayout>

            <!-- ALT: footer -->
            <Label Grid.Row="2" Text="Todo Voice v1.0" Style="{StaticResource CaptionText}"
                   HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,16" />

        </Grid>

    </Grid>

</ContentPage>
