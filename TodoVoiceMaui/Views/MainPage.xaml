<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TodoVoiceMaui.ViewModels"
             x:Class="TodoVoiceMaui.Views.MainPage"
             x:DataType="viewmodels:MainPageViewModel"
             Title="Ana Sayfa"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource DarkBackground}}">

    <Grid IsClippedToBounds="True">

        <!-- KATMAN 0 · AURORA ATMOSFER (renkli zemin = camın görünme koşulu)
             GradientStop içinde AppThemeBinding render edilmediği için
             hazır brush çiftlerine bağlanır (AuroraBackgroundLight/Dark). -->
        <Grid InputTransparent="True">
            <Grid.Background>
                <AppThemeBinding Light="{StaticResource AuroraBackgroundLight}" Dark="{StaticResource AuroraBackgroundDark}" />
            </Grid.Background>
        </Grid>

        <!-- ambient glow · şeftali/indigo (üst sol) — hero'nun arkası
             Light: görünür pastel süzülme (beyaz zemine uyarlanmış aurora)
             Dark: güçlü kromatik ambient -->
        <BoxView WidthRequest="460" HeightRequest="460" CornerRadius="230"
                 HorizontalOptions="Start" VerticalOptions="Start"
                 TranslationX="-140" TranslationY="-170"
                 Opacity="{AppThemeBinding Light=0.4, Dark=0.55}"
                 Color="Transparent"
                 InputTransparent="True">
            <BoxView.Background>
                <AppThemeBinding Light="{StaticResource GlowPeachLight}" Dark="{StaticResource GlowIndigoDark}" />
            </BoxView.Background>
        </BoxView>

        <!-- ambient glow · lavanta/mor (üst sağ) -->
        <BoxView WidthRequest="400" HeightRequest="400" CornerRadius="200"
                 HorizontalOptions="End" VerticalOptions="Start"
                 TranslationX="150" TranslationY="-120"
                 Opacity="{AppThemeBinding Light=0.36, Dark=0.5}"
                 Color="Transparent"
                 InputTransparent="True">
            <BoxView.Background>
                <AppThemeBinding Light="{StaticResource GlowLavenderLight}" Dark="{StaticResource GlowAmethystDark}" />
            </BoxView.Background>
        </BoxView>

        <!-- ambient glow · gökyüzü/turkuaz (alt sağ) — istatistik kartlarının arkası -->
        <BoxView WidthRequest="520" HeightRequest="520" CornerRadius="260"
                 HorizontalOptions="End" VerticalOptions="End"
                 TranslationX="180" TranslationY="230"
                 Opacity="{AppThemeBinding Light=0.42, Dark=0.6}"
                 Color="Transparent"
                 InputTransparent="True">
            <BoxView.Background>
                <AppThemeBinding Light="{StaticResource GlowSkyLight}" Dark="{StaticResource GlowTealDark}" />
            </BoxView.Background>
        </BoxView>

        <!-- ambient glow · nane/mor (alt sol) -->
        <BoxView WidthRequest="380" HeightRequest="380" CornerRadius="190"
                 HorizontalOptions="Start" VerticalOptions="End"
                 TranslationX="-150" TranslationY="180"
                 Opacity="{AppThemeBinding Light=0.34, Dark=0.45}"
                 Color="Transparent"
                 InputTransparent="True">
            <BoxView.Background>
                <AppThemeBinding Light="{StaticResource GlowMintLight}" Dark="{StaticResource GlowVioletDark}" />
            </BoxView.Background>
        </BoxView>

        <!-- KATMAN 1 · İÇERİK
             Deterministik kompozisyon:
             Row0 üst kimlik / Row1 üst boşluk / Row2 hero / Row3 alt boşluk / Row4 aksiyon.
             Star satırlar kalan yüksekliği eşit paylaşır → hero her koşulda ortada kalır,
             asla alta düşmez. -->
        <Grid Padding="24,14,24,14"
              RowDefinitions="Auto,*,Auto,*,Auto">

            <!-- ÜST BAR · kimlik -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding TodayLabel}"
                           Style="{StaticResource MicroLabel}"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource DarkTextTertiary}}" />
                    <Label Text="{Binding UserDisplayName}"
                           Style="{StaticResource SubtitleMedium}" />
                </VerticalStackLayout>

                <!-- ayarlar chip'i (tıklanabilir) -->
                <Border Grid.Column="1"
                        Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 999"
                        Padding="12,7"
                        VerticalOptions="Center">
                    <Border.Background>
                        <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToSettingsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                        <Label Text="&#xE713;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}"
                               VerticalOptions="Center" />
                        <Label Text="Ayarlar"
                               FontSize="12"
                               FontFamily="SoraSemiBold"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- üst boşluk satırı -->
            <BoxView Grid.Row="1" Color="Transparent" />

            <!-- HERO · voice-first kimlik kompozisyonu -->
            <VerticalStackLayout x:Name="HeroSection"
                                 Grid.Row="2"
                                 Spacing="0"
                                 HorizontalOptions="Center">

                <Label Text="KONUŞ"
                       Style="{StaticResource MicroLabel}"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}"
                       HorizontalOptions="Center" />

                <Label Text="Konuş."
                       Style="{StaticResource DisplayLarge}"
                       FontSize="32"
                       LineHeight="1.2"
                       HorizontalOptions="Center"
                       Margin="0,4,0,0" />

                <!-- MIC · tek bold element -->
                <Grid x:Name="MicRingGrid" WidthRequest="72" HeightRequest="72"
                      Margin="0,18,0,0"
                      HorizontalOptions="Center">

                    <!-- glow ring 1 · Light'ta zarif, Dark'ta belirgin -->
                    <BoxView Background="{AppThemeBinding Light={StaticResource AccentGlow}, Dark={StaticResource DarkAccentGlow}}"
                             CornerRadius="36"
                             Scale="1.35"
                             Opacity="{AppThemeBinding Light=0.6, Dark=1.0}"
                             InputTransparent="True" />
                    <!-- glow ring 2 -->
                    <BoxView Background="{AppThemeBinding Light={StaticResource AccentGlowSoft}, Dark={StaticResource DarkAccentGlowSoft}}"
                             CornerRadius="36"
                             Scale="1.7"
                             Opacity="{AppThemeBinding Light=0.55, Dark=1.0}"
                             InputTransparent="True" />

                    <!-- MIC circle -->
                    <Border Stroke="{AppThemeBinding Light={StaticResource GlassHighlight}, Dark={StaticResource DarkGlassHighlight}}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 999">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassSurfaceLight}" Dark="{StaticResource GlassSurfaceDark}" />
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToTodosCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light={StaticResource ShadowMd}, Dark={StaticResource DarkShadowMd}}"
                                    Offset="0,8"
                                    Radius="22"
                                    Opacity="0.5" />
                        </Border.Shadow>
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0.0"
                                                  Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                                    <GradientStop Offset="1.0"
                                                  Color="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Label Text="&#xE91F;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="26"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <Label Text="Dokun ve konuş"
                       Style="{StaticResource MicroLabel}"
                       HorizontalOptions="Center"
                       Margin="0,12,0,0" />

            </VerticalStackLayout>

            <!-- alt boşluk satırı -->
            <BoxView Grid.Row="3" Color="Transparent" />

            <!-- ALT BÖLGE · istatistikler + CTA -->
            <VerticalStackLayout x:Name="StatsSection" Grid.Row="4" Spacing="10">

                <!-- istatistikler · 3'lü tintli cam kart -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                    <!-- görev · indigo tint -->
                    <Border x:Name="StatCardTodos"
                            Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassTintIndigoLight}" Dark="{StaticResource GlassTintIndigoDark}" />
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer PointerEntered="OnStatPointerEntered" PointerExited="OnStatPointerExited" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,*">
                            <BoxView HeightRequest="1.5" Margin="12,0,12,0" VerticalOptions="Start">
                                <BoxView.Background>
                                    <AppThemeBinding Light="{StaticResource GlassSpecularLight}" Dark="{StaticResource GlassSpecularDark}" />
                                </BoxView.Background>
                            </BoxView>
                            <VerticalStackLayout Grid.Row="1" Spacing="2" HorizontalOptions="Center" Padding="10,9,10,10">
                                <Border WidthRequest="30" HeightRequest="30" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999" HorizontalOptions="Center"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource DarkAccentSoft}}">
                                    <Label Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{Binding TotalTodos}"
                                       Style="{StaticResource SubtitleMedium}"
                                       FontSize="18" LineHeight="1.2"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}"
                                       HorizontalOptions="Center" />
                                <Label Text="görev"
                                       Style="{StaticResource MicroLabel}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- tamam · yeşil tint -->
                    <Border x:Name="StatCardDone" Grid.Column="1"
                            Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassTintGreenLight}" Dark="{StaticResource GlassTintGreenDark}" />
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer PointerEntered="OnStatPointerEntered" PointerExited="OnStatPointerExited" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,*">
                            <BoxView HeightRequest="1.5" Margin="12,0,12,0" VerticalOptions="Start">
                                <BoxView.Background>
                                    <AppThemeBinding Light="{StaticResource GlassSpecularLight}" Dark="{StaticResource GlassSpecularDark}" />
                                </BoxView.Background>
                            </BoxView>
                            <VerticalStackLayout Grid.Row="1" Spacing="2" HorizontalOptions="Center" Padding="10,9,10,10">
                                <Border WidthRequest="30" HeightRequest="30" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999" HorizontalOptions="Center"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource VoiceReadySoft}, Dark={StaticResource DarkVoiceReadySoft}}">
                                    <Label Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource DarkSuccess}}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{Binding CompletedTodos}"
                                       Style="{StaticResource SubtitleMedium}"
                                       FontSize="18" LineHeight="1.2"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource DarkSuccess}}"
                                       HorizontalOptions="Center" />
                                <Label Text="tamam"
                                       Style="{StaticResource MicroLabel}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- sesli · turkuaz tint -->
                    <Border x:Name="StatCardVoice" Grid.Column="2"
                            Stroke="{AppThemeBinding Light={StaticResource GlassBorder}, Dark={StaticResource DarkGlassBorder}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">
                        <Border.Background>
                            <AppThemeBinding Light="{StaticResource GlassTintTealLight}" Dark="{StaticResource GlassTintTealDark}" />
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer PointerEntered="OnStatPointerEntered" PointerExited="OnStatPointerExited" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,*">
                            <BoxView HeightRequest="1.5" Margin="12,0,12,0" VerticalOptions="Start">
                                <BoxView.Background>
                                    <AppThemeBinding Light="{StaticResource GlassSpecularLight}" Dark="{StaticResource GlassSpecularDark}" />
                                </BoxView.Background>
                            </BoxView>
                            <VerticalStackLayout Grid.Row="1" Spacing="2" HorizontalOptions="Center" Padding="10,9,10,10">
                                <Border WidthRequest="30" HeightRequest="30" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999" HorizontalOptions="Center"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SecondarySoft}, Dark={StaticResource DarkSecondarySoft}}">
                                    <Label Text="&#xE91F;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{Binding VoiceTodos}"
                                       Style="{StaticResource SubtitleMedium}"
                                       FontSize="18" LineHeight="1.2"
                                       TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}"
                                       HorizontalOptions="Center" />
                                <Label Text="sesli"
                                       Style="{StaticResource MicroLabel}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </Grid>

                <!-- CTA -->
                <Button Text="Görevlerime Git"
                        Command="{Binding NavigateToTodosCommand}"
                        HeightRequest="42"
                        CornerRadius="21"
                        Margin="0,2,0,0" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
