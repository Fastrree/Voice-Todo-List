<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TodoVoiceMaui.Controls"
             xmlns:viewmodels="clr-namespace:TodoVoiceMaui.ViewModels"
             x:Class="TodoVoiceMaui.Views.MainPage"
             x:DataType="viewmodels:MainPageViewModel"
             Title="Ana Sayfa"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource DarkBackground}}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto"
              Padding="24">

            <!-- Header -->
            <StackLayout Grid.Row="0"
                        Spacing="8"
                        Margin="0,24,0,28">

                <Label Text="🎤"
                       FontSize="40"
                       HorizontalOptions="Center" />

                <Label Text="{Binding WelcomeMessage}"
                       Style="{StaticResource DisplayMedium}"
                       HorizontalOptions="Center" />

                <Label Text="Sesli görev yönetimi uygulamanız"
                       Style="{StaticResource CaptionText}"
                       HorizontalOptions="Center" />

            </StackLayout>

            <!-- Stats Dashboard -->
            <Grid Grid.Row="1"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="20">

                <StackLayout Grid.Row="0"
                            Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="GENEL BAKIŞ"
                               Style="{StaticResource MicroLabel}"
                               VerticalOptions="Center" />
                        <ActivityIndicator Grid.Column="1"
                                           IsRunning="{Binding IsLoadingStats}"
                                           IsVisible="{Binding IsLoadingStats}"
                                           Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}"
                                           VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="16"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="16">

                        <controls:GlassPanel Grid.Row="0" Grid.Column="0">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Toplam Görev"
                                       Style="{StaticResource CaptionText}" />
                                <Label Text="{Binding TotalTodos}"
                                       Style="{StaticResource DisplayLarge}"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkAccent}}" />
                            </VerticalStackLayout>
                        </controls:GlassPanel>

                        <controls:GlassPanel Grid.Row="0" Grid.Column="1">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Tamamlanan"
                                       Style="{StaticResource CaptionText}" />
                                <Label Text="{Binding CompletedTodos}"
                                       Style="{StaticResource DisplayLarge}"
                                       TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}" />
                            </VerticalStackLayout>
                        </controls:GlassPanel>

                        <controls:GlassPanel Grid.Row="1" Grid.Column="0">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Bekleyen"
                                       Style="{StaticResource CaptionText}" />
                                <Label Text="{Binding PendingTodos}"
                                       Style="{StaticResource DisplayLarge}"
                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource Warning}}" />
                            </VerticalStackLayout>
                        </controls:GlassPanel>

                        <controls:GlassPanel Grid.Row="1" Grid.Column="1">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Sesli Not"
                                       Style="{StaticResource CaptionText}" />
                                <Label Text="{Binding VoiceTodos}"
                                       Style="{StaticResource DisplayLarge}"
                                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource Danger}}" />
                            </VerticalStackLayout>
                        </controls:GlassPanel>

                    </Grid>

                </StackLayout>

                <!-- Quick Actions -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="16">

                    <controls:GlassPanel Grid.Column="0">
                        <controls:GlassPanel.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToTodosCommand}" />
                        </controls:GlassPanel.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="📝"
                                   FontSize="28"
                                   HorizontalOptions="Center" />
                            <Label Text="Görevler"
                                   Style="{StaticResource SubtitleMedium}"
                                   HorizontalOptions="Center" />
                            <Label Text="Görevlerinizi görüntüleyin ve yönetin"
                                   Style="{StaticResource CaptionText}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </controls:GlassPanel>

                    <controls:GlassPanel Grid.Column="1">
                        <controls:GlassPanel.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToSettingsCommand}" />
                        </controls:GlassPanel.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="⚙️"
                                   FontSize="28"
                                   HorizontalOptions="Center" />
                            <Label Text="Ayarlar"
                                   Style="{StaticResource SubtitleMedium}"
                                   HorizontalOptions="Center" />
                            <Label Text="Uygulama ayarlarını düzenleyin"
                                   Style="{StaticResource CaptionText}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </controls:GlassPanel>

                </Grid>

            </Grid>

            <!-- Footer -->
            <StackLayout Grid.Row="2"
                        Margin="0,24,0,12"
                        Spacing="12">

                <Button Text="Yenile"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource GhostButton}"
                        HorizontalOptions="Center" />

                <Label Text="Todo Voice v1.0"
                       Style="{StaticResource MicroLabel}"
                       HorizontalOptions="Center" />

            </StackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
